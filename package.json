{
  "name": "inventario-api",
  "version": "1.0.0",
  "description": "API REST de inventario multi-tienda: traslados, ajustes y reservas sin existencias negativas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    
    "seed": "tsx scripts/seed.ts"
  },
  "author": "Kevin Rodríguez",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
